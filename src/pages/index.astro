---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import AreaChartCard from '../components/AreaChartCard.tsx';
import MainLayout from '../layouts/MainLayout.astro';

import "../styles/global.css";
const someProps = {
	count: 0,
};
---
<script src="../scripts/theme.ts" is:inline></script>

<MainLayout>
  <Header slot="header" />
  <Sidebar slot="sidebar" />
  <div slot="content" class="p-4">
    <h2 class="text-on-background text-2xl mb-4">Welcome to the main content!</h2>
    <AreaChartCard client:load />
  </div>
  <Footer slot="footer" />
</MainLayout>
